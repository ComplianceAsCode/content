<def-group>
  <definition class="compliance" id="grub2_uefi_password" version="1">
    {{{ oval_metadata("The UEFI grub2 boot loader should have password protection enabled.", rule_title=rule_title) }}}

    <criteria operator="OR">
{{% if product in ["rhel8"] %}}
      <criterion comment="make sure a password is defined in /boot/grub2/user.cfg" test_ref="test_grub2_uefi_password_primary_usercfg" />
      <criteria operator="AND" comment="use the legacy user.cfg only when /boot/grub2/user.cfg is absent">
        <criterion comment="check that /boot/grub2/user.cfg is absent" test_ref="test_grub2_uefi_password_primary_usercfg_absent" />
        <criterion comment="make sure a password is defined in /boot/efi/EFI/redhat/user.cfg" test_ref="test_grub2_uefi_password_legacy_usercfg" />
      </criteria>
{{% else %}}
      <criterion comment="make sure a password is defined in {{{ grub2_uefi_boot_path }}}/user.cfg" test_ref="test_grub2_uefi_password_usercfg" />
{{% endif %}}
    </criteria>
  </definition>

{{% if product in ["rhel8"] %}}
  <ind:textfilecontent54_test check="all" check_existence="all_exist" comment="make sure a password is defined in /boot/grub2/user.cfg" id="test_grub2_uefi_password_primary_usercfg" version="1">
    <ind:object object_ref="object_grub2_uefi_password_primary_usercfg" />
  </ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="object_grub2_uefi_password_primary_usercfg" version="1">
    <ind:filepath>/boot/grub2/user.cfg</ind:filepath>
    <ind:pattern operation="pattern match">^[\s]*GRUB2_PASSWORD=grub\.pbkdf2\.sha512.*$</ind:pattern>
    <ind:instance datatype="int">1</ind:instance>
  </ind:textfilecontent54_object>

  <unix:file_test check="all" check_existence="none_exist" comment="check that /boot/grub2/user.cfg is absent" id="test_grub2_uefi_password_primary_usercfg_absent" version="1">
    <unix:object object_ref="object_grub2_uefi_password_primary_usercfg_absent" />
  </unix:file_test>
  <unix:file_object id="object_grub2_uefi_password_primary_usercfg_absent" version="1">
    <unix:filepath>/boot/grub2/user.cfg</unix:filepath>
  </unix:file_object>

  <ind:textfilecontent54_test check="all" check_existence="all_exist" comment="make sure a password is defined in /boot/efi/EFI/redhat/user.cfg" id="test_grub2_uefi_password_legacy_usercfg" version="1">
    <ind:object object_ref="object_grub2_uefi_password_legacy_usercfg" />
  </ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="object_grub2_uefi_password_legacy_usercfg" version="1">
    <ind:filepath>/boot/efi/EFI/redhat/user.cfg</ind:filepath>
    <ind:pattern operation="pattern match">^[\s]*GRUB2_PASSWORD=grub\.pbkdf2\.sha512.*$</ind:pattern>
    <ind:instance datatype="int">1</ind:instance>
  </ind:textfilecontent54_object>
{{% else %}}
  <ind:textfilecontent54_test check="all" check_existence="all_exist" comment="make sure a password is defined in {{{ grub2_uefi_boot_path }}}/user.cfg" id="test_grub2_uefi_password_usercfg" version="1">
    <ind:object object_ref="object_grub2_uefi_password_usercfg" />
  </ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="object_grub2_uefi_password_usercfg" version="1">
    <ind:filepath>{{{ grub2_uefi_boot_path }}}/user.cfg</ind:filepath>
    <ind:pattern operation="pattern match">^[\s]*GRUB2_PASSWORD=grub\.pbkdf2\.sha512.*$</ind:pattern>
    <ind:instance datatype="int">1</ind:instance>
  </ind:textfilecontent54_object>
{{% endif %}}

</def-group>
