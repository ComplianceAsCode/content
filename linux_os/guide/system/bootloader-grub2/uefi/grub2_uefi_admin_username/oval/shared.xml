<def-group>
  <definition class="compliance" id="grub2_uefi_admin_username" version="1">
    {{{ oval_metadata(
              "The grub2 boot loader superuser should have a username that is hard to guess.", rule_title=rule_title) }}}

    <criteria operator="OR">
{{% if product in ["rhel8"] %}}
      <criterion comment="superuser is defined in /boot/grub2/grub.cfg and is not root, admin, administrator, superuser, unlock, or a system username" test_ref="test_bootloader_uefi_primary_superuser_differ_from_other_users" />
      <criteria operator="AND" comment="use the legacy grub.cfg only when /boot/grub2/grub.cfg is absent">
        <criterion comment="check that /boot/grub2/grub.cfg is absent" test_ref="test_grub2_uefi_admin_username_primary_grubcfg_absent" />
        <criterion comment="superuser is defined in /boot/efi/EFI/redhat/grub.cfg and is not root, admin, administrator, superuser, unlock, or a system username" test_ref="test_bootloader_uefi_legacy_superuser_differ_from_other_users" />
      </criteria>
{{% else %}}
      <criterion comment="Superuser is defined in {{{ grub2_uefi_boot_path }}}/grub.cfg and it
            isn't root, admin, administrator nor equal to any system username"
            test_ref="test_bootloader_uefi_superuser_differ_from_other_users"/>
{{% endif %}}
    </criteria>
  </definition>

  <unix:password_object id="object_uefi_user_accounts" version="1">
    <unix:username datatype="string" operation="pattern match">.*</unix:username>
  </unix:password_object>

  <local_variable id="var_uefi_user_accounts" datatype="string" version="1" comment="Variable
          including all system usernames">
    <object_component item_field="username" object_ref="object_uefi_user_accounts"/>
  </local_variable>

  <ind:textfilecontent54_state id="state_bootloader_uefi_superuser_differ_from_other_users"
          version="1">
    <ind:subexpression datatype="string" operation="not equal" var_check="all"
          var_ref="var_uefi_user_accounts" />
  </ind:textfilecontent54_state>

{{% if product in ["rhel8"] %}}
{{% set superusers_regex = '^[\\s]*set[\\s]+superusers="(?i)\\b(?!(?:root|admin|administrator|superuser|unlock)\\b)(\\w+)".*\\n[\\s]*export[\\s]+superusers[\\s]*$' %}}
{{% else %}}
{{% set superusers_regex = '^[\\s]*set[\\s]+superusers="(?i)\\b(?!(?:root|admin|administrator)\\b)(\\w+)".*\\n[\\s]*export[\\s]+superusers[\\s]*$' %}}
{{% endif %}}

{{% if product in ["rhel8"] %}}
  <ind:textfilecontent54_test check="all" check_existence="all_exist" comment="superuser is defined in /boot/grub2/grub.cfg and is not root, admin, administrator, superuser, unlock, or a system username" id="test_bootloader_uefi_primary_superuser_differ_from_other_users" version="1">
    <ind:object object_ref="object_bootloader_uefi_primary_unique_superuser" />
    <ind:state state_ref="state_bootloader_uefi_superuser_differ_from_other_users" />
  </ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="object_bootloader_uefi_primary_unique_superuser" version="1">
    <ind:filepath>/boot/grub2/grub.cfg</ind:filepath>
    <ind:pattern operation="pattern match">{{{ superusers_regex }}}</ind:pattern>
    <ind:instance datatype="int">1</ind:instance>
  </ind:textfilecontent54_object>

  <unix:file_test check="all" check_existence="none_exist" comment="check that /boot/grub2/grub.cfg is absent" id="test_grub2_uefi_admin_username_primary_grubcfg_absent" version="1">
    <unix:object object_ref="object_grub2_uefi_admin_username_primary_grubcfg_absent" />
  </unix:file_test>
  <unix:file_object id="object_grub2_uefi_admin_username_primary_grubcfg_absent" version="1">
    <unix:filepath>/boot/grub2/grub.cfg</unix:filepath>
  </unix:file_object>

  <ind:textfilecontent54_test check="all" check_existence="all_exist" comment="superuser is defined in /boot/efi/EFI/redhat/grub.cfg and is not root, admin, administrator, superuser, unlock, or a system username" id="test_bootloader_uefi_legacy_superuser_differ_from_other_users" version="1">
    <ind:object object_ref="object_bootloader_uefi_legacy_unique_superuser" />
    <ind:state state_ref="state_bootloader_uefi_superuser_differ_from_other_users" />
  </ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="object_bootloader_uefi_legacy_unique_superuser" version="1">
    <ind:filepath>/boot/efi/EFI/redhat/grub.cfg</ind:filepath>
    <ind:pattern operation="pattern match">{{{ superusers_regex }}}</ind:pattern>
    <ind:instance datatype="int">1</ind:instance>
  </ind:textfilecontent54_object>
{{% else %}}
  <ind:textfilecontent54_test check="all" check_existence="all_exist" comment="superuser
          is defined in {{{ grub2_uefi_boot_path }}}/grub.cfg. Superuser is not
          equal to other system account nor root, admin, administrator"
          id="test_bootloader_uefi_superuser_differ_from_other_users" version="1">
    <ind:object object_ref="object_bootloader_uefi_unique_superuser" />
    <ind:state state_ref="state_bootloader_uefi_superuser_differ_from_other_users" />
  </ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="object_bootloader_uefi_unique_superuser" version="1">
    <ind:filepath>{{{ grub2_uefi_boot_path }}}/grub.cfg</ind:filepath>
    <ind:pattern operation="pattern match">{{{ superusers_regex }}}</ind:pattern>
    <ind:instance datatype="int">1</ind:instance>
  </ind:textfilecontent54_object>
{{% endif %}}

</def-group>
