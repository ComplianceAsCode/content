<def-group>
  <definition class="compliance" id="mount_option_tmp_nodev" version="1">
    {{{ oval_metadata("ensure tmp.mount services has nodev option configured.") }}}
    <criteria>
        <criterion comment="check nodev is set in Options in /usr/lib/systemd/system/tmp.mount" test_ref="test_tmp_mount_nodev_option" />
    </criteria>
  </definition>

  <ind:textfilecontent54_test check="all" check_existence="all_exist" comment="check nodev is set in Options in /usr/lib/systemd/system/tmp.mount" id="test_tmp_mount_nodev_option" version="1">
    <ind:object object_ref="object_tmp_mount_nodev_option" />
  </ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="object_tmp_mount_nodev_option" comment="Options has  nodev set in /usr/lib/systemd/system/tmp.mount" version="1">
    <ind:filepath>/usr/lib/systemd/system/tmp.mount</ind:filepath>
    <ind:pattern operation="pattern match">^[\s]*Options=.*nodev.*$</ind:pattern>
    <ind:instance datatype="int" operation="equals">1</ind:instance>
  </ind:textfilecontent54_object>

</def-group>
