<def-group>
  <definition class="compliance" id="{{{ rule_id }}}" version="1">
    {{{ oval_metadata("The TuxCare ESU repository must be configured and enabled.", rule_title=rule_title) }}}
    <criteria operator="AND">
      <criterion comment="The tuxcare-esu repository is configured in /etc/yum.repos.d"
      test_ref="test_{{{ rule_id }}}_configured" />
      <criterion comment="The tuxcare-esu repository is not disabled"
      test_ref="test_{{{ rule_id }}}_not_disabled" />
    </criteria>
  </definition>

  <ind:textfilecontent54_test check="all" check_existence="at_least_one_exists"
  comment="A [tuxcare-esu] section exists in a repository file"
  id="test_{{{ rule_id }}}_configured" version="1">
    <ind:object object_ref="obj_{{{ rule_id }}}_configured" />
  </ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="obj_{{{ rule_id }}}_configured" version="1">
    <ind:path>/etc/yum.repos.d</ind:path>
    <ind:filename operation="pattern match">^.*\.repo$</ind:filename>
    <ind:pattern operation="pattern match">^\[tuxcare-esu\]\s*$</ind:pattern>
    <ind:instance datatype="int">1</ind:instance>
  </ind:textfilecontent54_object>

  <!-- A repository section without an enabled option is enabled by default,
       so only an explicit enabled=0 inside the section is a finding. -->
  <ind:textfilecontent54_test check="all" check_existence="none_exist"
  comment="The [tuxcare-esu] section does not contain enabled=0"
  id="test_{{{ rule_id }}}_not_disabled" version="1">
    <ind:object object_ref="obj_{{{ rule_id }}}_not_disabled" />
  </ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="obj_{{{ rule_id }}}_not_disabled" version="1">
    <ind:path>/etc/yum.repos.d</ind:path>
    <ind:filename operation="pattern match">^.*\.repo$</ind:filename>
    <ind:pattern operation="pattern match">^\[tuxcare-esu\][^\[]*^\s*enabled\s*=\s*0\s*$</ind:pattern>
    <ind:instance datatype="int">1</ind:instance>
  </ind:textfilecontent54_object>
</def-group>
