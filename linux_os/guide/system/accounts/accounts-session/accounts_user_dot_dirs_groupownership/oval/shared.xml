<def-group>
  <definition class="compliance" id="{{{ rule_id }}}" version="1">
    {{{ oval_metadata("Interactive user dot directories have valid group owners.", rule_title=rule_title) }}}
    <criteria>
      <criterion comment="Dot directory group owners are valid"
        test_ref="test_{{{ rule_id }}}" />
    </criteria>
  </definition>
  {{%- set home_dirs_object = "object_" ~ rule_id ~ "_home_dirs" -%}}
  {{{ create_local_interactive_users_home_dirs_list_object(home_dirs_object) }}}
  {{%- set gids_object = "object_" ~ rule_id ~ "_gids" -%}}
  {{{ create_local_interactive_users_gids_list_object(gids_object) }}}
  <local_variable id="var_{{{ rule_id }}}_home_dirs" datatype="string" version="1"
    comment="Home directories of local interactive users">
    <object_component item_field="subexpression" object_ref="{{{ home_dirs_object }}}" />
  </local_variable>
  <local_variable id="var_{{{ rule_id }}}_gids" datatype="int" version="1"
    comment="Primary group IDs of local interactive users">
    <object_component item_field="subexpression" object_ref="{{{ gids_object }}}" />
  </local_variable>
  <unix:file_test check="all" check_existence="any_exist" id="test_{{{ rule_id }}}"
    version="1" comment="Dot directory group owners are valid">
    <unix:object object_ref="obj_{{{ rule_id }}}_dot_dirs" />
    <unix:state state_ref="state_{{{ rule_id }}}_groups" />
  </unix:file_test>
  <unix:file_object id="obj_{{{ rule_id }}}_dot_dirs" version="1">
    <unix:behaviors recurse="directories" recurse_direction="down" max_depth="-1"
      recurse_file_system="local" />
    <unix:path var_ref="var_{{{ rule_id }}}_home_dirs" var_check="at least one" />
    <unix:filename operation="pattern match">^\..*</unix:filename>
    <filter action="include">state_{{{ rule_id }}}_directory</filter>
  </unix:file_object>
  <unix:file_state id="state_{{{ rule_id }}}_directory" version="1">
    <unix:type>directory</unix:type>
  </unix:file_state>
  <unix:file_state id="state_{{{ rule_id }}}_groups" version="1">
    <unix:group_id datatype="int" var_check="only one" var_ref="var_{{{ rule_id }}}_gids" />
  </unix:file_state>
</def-group>
