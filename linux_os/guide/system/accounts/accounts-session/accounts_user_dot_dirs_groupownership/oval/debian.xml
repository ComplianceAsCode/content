<def-group>
  <definition class="compliance" id="{{{ rule_id }}}" version="1">
    {{{ oval_metadata("Dot directories below local interactive user home directories are group-owned by the primary group of a local interactive user, and dot directories below the home directories of users with UID 0 are group-owned by the primary group of a user with UID 0.", rule_title=rule_title) }}}
    <criteria operator="AND">
      <criterion comment="Dot directories below the home directories of local interactive users other than root are group-owned by the primary group of one of those users"
        test_ref="test_{{{ rule_id }}}_user" />
      <criterion comment="Dot directories below the home directories of local interactive users with UID 0 are group-owned by the primary group of a user with UID 0"
        test_ref="test_{{{ rule_id }}}_root" />
    </criteria>
  </definition>

  <unix:file_test check="all" check_existence="any_exist"
    id="test_{{{ rule_id }}}_user" version="1"
    comment="Dot directories below the home directories of local interactive users other than root are group-owned by the primary group of one of those users">
    <unix:object object_ref="obj_{{{ rule_id }}}_user_dot_dirs" />
    <unix:state state_ref="state_{{{ rule_id }}}_user_owner" />
  </unix:file_test>

  <unix:file_test check="all" check_existence="any_exist"
    id="test_{{{ rule_id }}}_root" version="1"
    comment="Dot directories below the home directories of local interactive users with UID 0 are group-owned by the primary group of a user with UID 0">
    <unix:object object_ref="obj_{{{ rule_id }}}_root_dot_dirs" />
    <unix:state state_ref="state_{{{ rule_id }}}_root_owner" />
  </unix:file_test>

  <unix:file_state id="state_{{{ rule_id }}}_user_owner" version="1">
    <unix:group_id datatype="int" var_ref="var_{{{ rule_id }}}_user_gids" var_check="at least one" />
  </unix:file_state>

  <unix:file_state id="state_{{{ rule_id }}}_root_owner" version="1">
    <unix:group_id datatype="int" var_ref="var_{{{ rule_id }}}_root_gids" var_check="at least one" />
  </unix:file_state>

  <unix:file_object id="obj_{{{ rule_id }}}_user_dot_dirs" version="1"
    comment="Dot directories below the home directories of local interactive users other than root">
    <unix:behaviors recurse="directories" recurse_direction="down" max_depth="-1"
      recurse_file_system="local" />
    <unix:path var_ref="var_{{{ rule_id }}}_user_homes" var_check="at least one" />
    <unix:filename xsi:nil="true" />
    <filter action="include">state_{{{ rule_id }}}_dot_dir</filter>
  </unix:file_object>

  <unix:file_object id="obj_{{{ rule_id }}}_root_dot_dirs" version="1"
    comment="Dot directories below the home directories of local interactive users with UID 0">
    <unix:behaviors recurse="directories" recurse_direction="down" max_depth="-1"
      recurse_file_system="local" />
    <unix:path var_ref="var_{{{ rule_id }}}_root_homes" var_check="at least one" />
    <unix:filename xsi:nil="true" />
    <filter action="include">state_{{{ rule_id }}}_dot_dir</filter>
  </unix:file_object>

  <unix:file_state id="state_{{{ rule_id }}}_dot_dir" version="1">
    <unix:path operation="pattern match">/\.[^/]+$</unix:path>
  </unix:file_state>

  <!-- Local interactive users: /etc/passwd entries whose shell is listed in
       /etc/shells and is not nologin or false. -->
  <ind:textfilecontent54_object id="obj_{{{ rule_id }}}_shells" version="1">
    <ind:filepath>/etc/shells</ind:filepath>
    <ind:pattern operation="pattern match">^[ \t]*(/[^\s#]+)[ \t]*$</ind:pattern>
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
    <filter action="exclude">state_{{{ rule_id }}}_nologin_shells</filter>
  </ind:textfilecontent54_object>
  <ind:textfilecontent54_state id="state_{{{ rule_id }}}_nologin_shells" version="1">
    <ind:subexpression operation="pattern match">/(?:nologin|false)$</ind:subexpression>
  </ind:textfilecontent54_state>

  <local_variable id="var_{{{ rule_id }}}_user_homes_regex" datatype="string" version="1"
    comment="Regular expressions that capture the home directories of local interactive users other than root">
    <concat>
      <literal_component>^[^:]*:[^:]*:(?!0:)[0-9]+:[^:]*:[^:]*:([^:]+):</literal_component>
      <escape_regex>
        <object_component item_field="subexpression" object_ref="obj_{{{ rule_id }}}_shells" />
      </escape_regex>
      <literal_component>$</literal_component>
    </concat>
  </local_variable>
  <ind:textfilecontent54_object id="obj_{{{ rule_id }}}_user_homes" version="1">
    <ind:filepath>/etc/passwd</ind:filepath>
    <ind:pattern operation="pattern match" var_ref="var_{{{ rule_id }}}_user_homes_regex" var_check="at least one" />
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>
  <local_variable id="var_{{{ rule_id }}}_user_homes" datatype="string" version="1"
    comment="The home directories of local interactive users other than root">
    <object_component item_field="subexpression" object_ref="obj_{{{ rule_id }}}_user_homes" />
  </local_variable>

  <local_variable id="var_{{{ rule_id }}}_root_homes_regex" datatype="string" version="1"
    comment="Regular expressions that capture the home directories of local interactive users with UID 0">
    <concat>
      <literal_component>^[^:]*:[^:]*:0:[^:]*:[^:]*:([^:]+):</literal_component>
      <escape_regex>
        <object_component item_field="subexpression" object_ref="obj_{{{ rule_id }}}_shells" />
      </escape_regex>
      <literal_component>$</literal_component>
    </concat>
  </local_variable>
  <ind:textfilecontent54_object id="obj_{{{ rule_id }}}_root_homes" version="1">
    <ind:filepath>/etc/passwd</ind:filepath>
    <ind:pattern operation="pattern match" var_ref="var_{{{ rule_id }}}_root_homes_regex" var_check="at least one" />
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>
  <local_variable id="var_{{{ rule_id }}}_root_homes" datatype="string" version="1"
    comment="The home directories of local interactive users with UID 0">
    <object_component item_field="subexpression" object_ref="obj_{{{ rule_id }}}_root_homes" />
  </local_variable>

  <local_variable id="var_{{{ rule_id }}}_user_gids_regex" datatype="string" version="1"
    comment="Regular expressions that capture the primary group IDs of local interactive users other than root">
    <concat>
      <literal_component>^[^:]*:[^:]*:(?!0:)[0-9]+:([0-9]+):[^:]*:[^:]*:</literal_component>
      <escape_regex>
        <object_component item_field="subexpression" object_ref="obj_{{{ rule_id }}}_shells" />
      </escape_regex>
      <literal_component>$</literal_component>
    </concat>
  </local_variable>
  <ind:textfilecontent54_object id="obj_{{{ rule_id }}}_user_gids" version="1">
    <ind:filepath>/etc/passwd</ind:filepath>
    <ind:pattern operation="pattern match" var_ref="var_{{{ rule_id }}}_user_gids_regex" var_check="at least one" />
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>
  <local_variable id="var_{{{ rule_id }}}_user_gids" datatype="int" version="1"
    comment="The primary group IDs of local interactive users other than root">
    <object_component item_field="subexpression" object_ref="obj_{{{ rule_id }}}_user_gids" />
  </local_variable>

  <local_variable id="var_{{{ rule_id }}}_root_gids_regex" datatype="string" version="1"
    comment="Regular expressions that capture the primary group IDs of local interactive users with UID 0">
    <concat>
      <literal_component>^[^:]*:[^:]*:0:([0-9]+):[^:]*:[^:]*:</literal_component>
      <escape_regex>
        <object_component item_field="subexpression" object_ref="obj_{{{ rule_id }}}_shells" />
      </escape_regex>
      <literal_component>$</literal_component>
    </concat>
  </local_variable>
  <ind:textfilecontent54_object id="obj_{{{ rule_id }}}_root_gids" version="1">
    <ind:filepath>/etc/passwd</ind:filepath>
    <ind:pattern operation="pattern match" var_ref="var_{{{ rule_id }}}_root_gids_regex" var_check="at least one" />
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>
  <local_variable id="var_{{{ rule_id }}}_root_gids" datatype="int" version="1"
    comment="The primary group IDs of local interactive users with UID 0">
    <object_component item_field="subexpression" object_ref="obj_{{{ rule_id }}}_root_gids" />
  </local_variable>
</def-group>
