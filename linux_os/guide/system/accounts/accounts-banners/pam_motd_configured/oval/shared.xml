<def-group>
  <definition class="compliance" id="{{{ rule_id }}}" version="1">
    {{{ oval_metadata("pam_motd uses explicit, non-disclosing message files.", rule_title=rule_title) }}}
    <criteria operator="AND">
      <criterion comment="At least one explicit pam_motd message path is configured"
        test_ref="test_{{{ rule_id }}}_configured" />
      <criterion comment="Referenced message files exist"
        test_ref="test_{{{ rule_id }}}_files_exist" />
      <criterion comment="Referenced message files do not disclose system information"
        test_ref="test_{{{ rule_id }}}_safe_content" />
    </criteria>
  </definition>

  <ind:textfilecontent54_test check="all" check_existence="at_least_one_exists"
    id="test_{{{ rule_id }}}_configured" version="1"
    comment="An explicit pam_motd motd path is configured">
    <ind:object object_ref="obj_{{{ rule_id }}}_pam_entries" />
  </ind:textfilecontent54_test>

  <ind:textfilecontent54_object id="obj_{{{ rule_id }}}_pam_entries" version="1">
    <ind:path>/etc/pam.d</ind:path>
    <ind:filename operation="pattern match">^(sshd|login|su|gdm-password)$</ind:filename>
    <ind:pattern operation="pattern match">^[\s]*session[\s]+[^#\n]*pam_motd\.so[^#\n]*[\s]motd=([^\s#]+).*$</ind:pattern>
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>

  <local_variable id="var_{{{ rule_id }}}_motd_paths" datatype="string" version="1"
    comment="Explicit pam_motd message paths">
    <object_component item_field="subexpression" object_ref="obj_{{{ rule_id }}}_pam_entries" />
  </local_variable>

  <unix:file_test check="all" check_existence="all_exist"
    id="test_{{{ rule_id }}}_files_exist" version="1"
    comment="All explicit pam_motd files exist">
    <unix:object object_ref="obj_{{{ rule_id }}}_motd_files" />
  </unix:file_test>
  <unix:file_object id="obj_{{{ rule_id }}}_motd_files" version="1">
    <unix:filepath var_ref="var_{{{ rule_id }}}_motd_paths" var_check="at least one" />
  </unix:file_object>

  <ind:textfilecontent54_test check="all" check_existence="none_exist"
    id="test_{{{ rule_id }}}_safe_content" version="1"
    comment="Message files contain no system-information tokens">
    <ind:object object_ref="obj_{{{ rule_id }}}_unsafe_content" />
  </ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="obj_{{{ rule_id }}}_unsafe_content" version="1">
    <ind:filepath var_ref="var_{{{ rule_id }}}_motd_paths" var_check="at least one" />
    <ind:pattern operation="pattern match">^.*(\\[vrms]|(?i:Ubuntu|Debian|GNU/Linux)).*$</ind:pattern>
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>
</def-group>
