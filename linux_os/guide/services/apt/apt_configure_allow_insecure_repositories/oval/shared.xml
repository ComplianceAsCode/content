<def-group>
  <definition class="compliance" id="{{{ rule_id }}}" version="1">
    {{{ oval_metadata("APT does not explicitly allow insecure repositories.", rule_title=rule_title) }}}
    <criteria>
      <criterion comment="No enabling setting exists" test_ref="test_{{{ rule_id }}}_no_enabled" />
    </criteria>
  </definition>
  <ind:textfilecontent54_test check="all" check_existence="none_exist"
    id="test_{{{ rule_id }}}_no_enabled" version="1" comment="No true or 1 value exists">
    <ind:object object_ref="obj_{{{ rule_id }}}_enabled" />
  </ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="obj_{{{ rule_id }}}_enabled" version="1">
    <ind:filepath operation="pattern match">/etc/apt/apt\.conf(\.d/.*)?$</ind:filepath>
    <ind:pattern operation="pattern match">^[\s]*(?i)Acquire::AllowInsecureRepositories(?-i)[\s]+&quot;?(?i)(1|true|yes|with|on)(?-i)&quot;?[\s]*;[\s]*(#.*)?$</ind:pattern>
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>
</def-group>
