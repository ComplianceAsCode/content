<def-group>
  <definition class="compliance" id="file_ownership_var_log_audit" version="3">
    {{{ oval_metadata("Checks that all /var/log/audit files and directories are owned by the root user and group.", rule_title=rule_title) }}}
    <criteria operator="OR">
      <criteria operator="AND" comment="directories are root owned">
        <extend_definition comment="log_group in auditd.conf is root or not set"
        definition_ref="auditd_conf_log_group_not_root" negate="true"/>
        <criterion test_ref="test_ownership_var_log_audit_files" />
        <criterion test_ref="test_ownership_var_log_audit_directories" />
      </criteria>
      <criteria operator="AND" comment="log_group in auditd.conf is not root">
        <extend_definition comment="log_group in auditd.conf is not root"
        definition_ref="auditd_conf_log_group_not_root" />
        <criterion test_ref="test_ownership_var_log_audit_files-non_root" />
        <criterion test_ref="test_ownership_var_log_audit_directories-non_root" />
      </criteria>
    </criteria>
  </definition>

  <unix:file_test check="all" check_existence="none_exist" comment="/var/log/audit directories uid root gid root"
      id="test_ownership_var_log_audit_directories" version="1">
    <unix:object object_ref="object_ownership_var_log_audit_directories" />
  </unix:file_test>

  <unix:file_test check="all" check_existence="none_exist" comment="/var/log/audit files uid root gid root"
      id="test_ownership_var_log_audit_files" version="1">
    <unix:object object_ref="object_ownership_var_log_audit_files" />
  </unix:file_test>

  <unix:file_object comment="/var/log/audit directories" id="object_ownership_var_log_audit_directories" version="1">
    <unix:behaviors recurse="directories" recurse_direction="down" max_depth="-1" recurse_file_system="all" />
    <unix:path operation="equals">/var/log/audit</unix:path>
    <unix:filename xsi:nil="true" />
    <filter action="include">state_owner_not_root_root_var_log_audit</filter>
  </unix:file_object>

  <unix:file_object comment="/var/log/audit files" id="object_ownership_var_log_audit_files" version="1">
    <unix:behaviors recurse="directories" recurse_direction="down" max_depth="-1" recurse_file_system="all" />
    <unix:path operation="equals">/var/log/audit</unix:path>
    <unix:filename operation="pattern match">^.*$</unix:filename>
    <filter action="include">state_owner_not_root_root_var_log_audit</filter>
  </unix:file_object>

  <unix:file_state id="state_owner_not_root_root_var_log_audit" version="1" operator="OR">
    <unix:group_id datatype="int" operation="not equal">0</unix:group_id>
    <unix:user_id datatype="int" operation="not equal">0</unix:user_id>
  </unix:file_state>

  <unix:file_test check="all" check_existence="none_exist" comment="/var/log/audit directories uid root gid root" id="test_ownership_var_log_audit_directories-non_root" version="1">
    <unix:object object_ref="object_ownership_var_log_audit_directories-non_root" />
  </unix:file_test>

  <unix:file_test check="all" check_existence="none_exist" comment="/var/log/audit files uid root gid root" id="test_ownership_var_log_audit_files-non_root" version="1">
    <unix:object object_ref="object_ownership_var_log_audit_files-non_root" />
  </unix:file_test>

  <unix:file_object comment="/var/log/audit directories" id="object_ownership_var_log_audit_directories-non_root" version="1">
    <unix:behaviors recurse="directories" recurse_direction="down" max_depth="-1" recurse_file_system="all" />
    <unix:path operation="equals">/var/log/audit</unix:path>
    <unix:filename xsi:nil="true" />
    <filter action="include">state_owner_not_root_var_log_audit-non_root</filter>
  </unix:file_object>

  <unix:file_object comment="/var/log/audit files" id="object_ownership_var_log_audit_files-non_root" version="1">
    <unix:behaviors recurse="directories" recurse_direction="down" max_depth="-1" recurse_file_system="all" />
    <unix:path operation="equals">/var/log/audit</unix:path>
    <unix:filename operation="pattern match">^.*$</unix:filename>
    <filter action="include">state_owner_not_root_var_log_audit-non_root</filter>
  </unix:file_object>

  <unix:file_state id="state_owner_not_root_var_log_audit-non_root" version="1" operator="OR">
    <unix:group_id datatype="int" operation="not equal" var_ref="var_file_groupowner_audit_log_group_gid_{{{ rule_id }}}"></unix:group_id>
    <unix:user_id datatype="int" operation="not equal">0</unix:user_id>
  </unix:file_state>


  <!-- default file and non default state -->
  <ind:textfilecontent54_object id="obj_auditd_conf_log_group_configured" comment="log_group is set" version="1">
    <ind:filepath operation="equals">/etc/audit/auditd.conf</ind:filepath>
    <ind:pattern operation="pattern match">^[ ]*log_group[ ]+=[ ](\w+)$</ind:pattern>
    <ind:instance datatype="int">1</ind:instance>
  </ind:textfilecontent54_object>

  <local_variable id="var_auditd_conf_log_group_{{{ rule_id }}}" version="1" datatype="string" comment="audit log_group">
    <object_component item_field="subexpression" object_ref="obj_auditd_conf_log_group_configured" />
  </local_variable>

  <local_variable id="var_auditd_conf_log_group_regex_{{{ rule_id }}}" datatype="string" version="1"
    comment="a local variable regex to auditd configured log_group">
      <concat>
          <literal_component>^</literal_component>
          <variable_component var_ref="var_auditd_conf_log_group_{{{ rule_id }}}"/>
          <literal_component>:\w+:(\w+):.*</literal_component>
      </concat>
  </local_variable>

  <ind:textfilecontent54_object id="object_auditd_log_group_etc_group_id_{{{ rule_id }}}" version="1" comment="gid of the audit log_group (from /etc/group)">
    <ind:filepath>/etc/group</ind:filepath>
    <ind:pattern operation="pattern match" var_ref="var_auditd_conf_log_group_regex_{{{ rule_id }}}"/>
    <ind:instance datatype="int" operation="equals">1</ind:instance>
  </ind:textfilecontent54_object>

  <local_variable id="var_file_groupowner_audit_log_group_gid_{{{ rule_id }}}" datatype="int" version="1" comment="Retrieve the gid audit log_group">
    <object_component item_field="subexpression" object_ref="object_auditd_log_group_etc_group_id_{{{ rule_id }}}"/>
  </local_variable>
</def-group>
