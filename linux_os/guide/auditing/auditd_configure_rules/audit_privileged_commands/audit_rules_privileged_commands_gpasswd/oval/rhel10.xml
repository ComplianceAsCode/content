    <ind:pattern operation="pattern match">^[\s]*-a[\s]+(?:always,exit|exit,always)[\s]+-F[\s]+arch=b64[\s]+-F[\s]+path=\/usr\/bin\/gpasswd[\s]+(?:-F[\s]+auid>={{{ auid }}}[\s]+-F[\s]+auid!=(?:4294967295|-1|unset)[\s]+)?-F[\s]+perm=[rwa]*x[rwa]*(?:[\s]+(?:-k[\s]+|-F[\s]+key=)[-\w]+)*[\s]*$</ind:pattern>
    <ind:instance operation="greater than or equal" datatype="int">1</ind:instance>
  </ind:textfilecontent54_object>

