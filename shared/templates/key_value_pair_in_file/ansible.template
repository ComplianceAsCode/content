# platform = multi_platform_all
# reboot = false
# strategy = configure
# complexity = low
# disruption = low

{{%- set _kvp_default_mode = FILEMODE if FILEMODE else '0644' %}}
{{%- set _kvp_mode = "{{ kvp_mode_stat.stat.mode if kvp_mode_stat.stat.exists else '" ~ _kvp_default_mode ~ "' }}" %}}
{{{ ansible_stat("Check the current permissions of " ~ PATH ~ " to preserve them", path=PATH, register="kvp_mode_stat") }}}
{{% if XCCDF_VARIABLE %}}
{{{ ansible_instantiate_variables(XCCDF_VARIABLE) }}}
{{{ ansible_set_config_file(msg, PATH, KEY, value="{{ "+XCCDF_VARIABLE+" }}", create=true, mode=_kvp_mode, separator=SEP, separator_regex=SEP_REGEX, prefix_regex=PREFIX_REGEX, rule_title=rule_title) }}}
{{% else %}}
{{{ ansible_set_config_file(msg, PATH, KEY, value=VALUE, create=true, mode=_kvp_mode, separator=SEP, separator_regex=SEP_REGEX, prefix_regex=PREFIX_REGEX, rule_title=rule_title) }}}
{{% endif %}}
