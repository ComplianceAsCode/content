# platform = multi_platform_all
# reboot = false
# strategy = disable
# complexity = low
# disruption = low

# Ansible's service_facts only collects service units, not socket units, so the
# socket unit file is located on disk to decide whether the socket is present.
- name: "{{{ rule_title }}} - Collect systemd Socket Units Present in the System"
  ansible.builtin.find:
    paths:
      - /etc/systemd/system
      - /run/systemd/system
      - /usr/lib/systemd/system
      - /usr/local/lib/systemd/system
    patterns: "{{{ SOCKETNAME }}}.socket"
    file_type: any
  register: result_systemd_unit_files
  check_mode: false

- name: "{{{ rule_title }}} - Ensure {{{ SOCKETNAME }}}.socket is Masked"
  ansible.builtin.systemd:
    name: {{{ SOCKETNAME }}}.socket
    state: stopped
    enabled: false
    masked: true
  when:
    - result_systemd_unit_files.matched > 0
