<def-group>
  <definition class="inventory" id="installed_OS_is_uosdesktop20" version="1">
    <metadata>
      <title>UOS Desktop 20</title>
      <affected family="unix">
        <platform>multi_platform_all</platform>
      </affected>
      <description>The operating system installed on the system is UOS Desktop 20.</description>
    </metadata>
    <criteria operator="AND">
      <criterion comment="UOS Desktop 20 is installed" test_ref="test_uosdesktop20_installed" />
    </criteria>
  </definition>

  <ind:textfilecontent54_test check="all" check_existence="at_least_one_exists" comment="UOS Desktop 20 is installed" id="test_uosdesktop20_installed" version="1">
    <ind:object object_ref="obj_uosdesktop20_installed" />
  </ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="obj_uosdesktop20_installed" version="1" comment="Look for UOS Desktop 20 in os-release">
    <ind:filepath>/usr/lib/os-release</ind:filepath>
    <ind:pattern operation="pattern match">^PRETTY_NAME=&quot;UOS Desktop 20.*$</ind:pattern>
    <ind:instance datatype="int">1</ind:instance>
  </ind:textfilecontent54_object>

</def-group>
